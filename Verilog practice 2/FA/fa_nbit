`include "FA_behv.v"
module nbit_fa #(
	parameter N = 10
)(
	input [N-1] a, b,
	input cin,
	output [N-1] sum,
	output co
);
	genvar i;
	wire [N:0] c;
	
	assign c[0] = cin;
	assign co = c[N];
	
	for (i=0; i<N; i=i+1) begin
		FA w1(.a(a(i)), .b(b(i)), .Cin(c(i)), .carry(c(i+1)));

	end
endmodule
